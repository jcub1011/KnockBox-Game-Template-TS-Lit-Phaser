{
  "name": "knockbox-game-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.authority.json",
    "build:app": "vite build",
    "build:authority": "vite build --config vite.authority.config.ts",
    "build": "npm run typecheck && npm run build:app && npm run build:authority",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "manifest:check": "node scripts/check-manifest.mjs",
    "addon:check": "node node_modules/knockbox-cli/knockbox.mjs addon check",
    "addon:update": "node node_modules/knockbox-cli/knockbox.mjs addon update",
    "export:game": "npm run manifest:check && node node_modules/knockbox-cli/knockbox.mjs pack --build \"npm run build\" --in dist --manifest export/GAME.json --out dist-game/"
  },
  "dependencies": {
    "lit": "3.x",
    "phaser": "4.x"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.x",
    "@eslint/js": "10.x",
    "@types/node": "24.x",
    "eslint": "10.x",
    "eslint-config-prettier": "10.x",
    "globals": "17.x",
    "happy-dom": "20.x",
    "knockbox-cli": "1.x",
    "prettier": "3.x",
    "typescript": "6.x",
    "typescript-eslint": "8.x",
    "vite": "8.x",
    "vitest": "5.x"
  }
}
